{
  "rewrites": [
    { "source": "/a", "destination": "/api/a" },
    { "source": "/s", "destination": "/api/s" },
    { "source": "/f", "destination": "/api/f" },
    { "source": "/h.hta", "destination": "/api/h" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
