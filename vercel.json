{
  "cleanUrls": false,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/s.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/p.hta", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }] }
  ]
}
